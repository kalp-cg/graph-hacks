# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6380          # host port; 6379 is often taken by a local redis/valkey
FALKORDB_USERNAME=          # set for FalkorDB Cloud
FALKORDB_PASSWORD=          # set for FalkorDB Cloud
GRAPH_NAME=sentinel

# LLM (used from Day 2)
LLM_PROVIDER=ollama         # ollama | gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=
LLM_MODEL=
LLM_MAX_STEPS=15

# App
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
DEMO_REPLAY=false
